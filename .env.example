# Copy this file to .env.local and fill in the public key.
#
# The contact form sends inquiries through EmailJS, exactly like the current site.
# Service and template IDs below are the ones the live site uses today.
# The public key is in your EmailJS dashboard under Account > General > Public Key.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_gp8kf5j
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_h7j16tk
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Used for canonical URLs, the sitemap and social-share previews.
NEXT_PUBLIC_SITE_URL=https://vismayintlcorp.com
